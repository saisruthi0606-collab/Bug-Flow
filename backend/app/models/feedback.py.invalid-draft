from sqlalchemy import Column, DateTime, ForeignKey, Integer, String, Text
from sqlalchemy.orm import relationship
from sqlalchemy.sql import func
from ..db.database import Base


class AIFeedback(Base):
    __tablename__ = "ai_feedback"
    id = Column(Integer, primary_key=True, index=True)
    user_id = Column(Integer, ForeignKey("users.id"), nullable=False, index=True)
    feedback_type = Column(String(20), nullable=False)  # 'helpful' | 'not_helpful'
    source = Column(String(50), nullable=False)  # 'chat' | 'investigation' | 'recommendation' | 'analysis'
    message_ref = Column(String(255), nullable=True)  # reference to the AI response (e.g. chat message id, issue id)
    comment = Column(Text, nullable=True)
    created_at = Column(DateTime(timezone=True), server_default=func.now(), nullable=False)
    user = relationship("User", backref="ai_feedback")
